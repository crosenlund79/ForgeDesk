<Window x:Class="ForgeDesk.Views.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ForgeDesk.Views"
        Title="Projects — ForgeDesk" Width="980" Height="640" MinWidth="760" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Project list -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16,14,14">
                <TextBlock DockPanel.Dock="Top" Text="PROJECTS" Style="{StaticResource SectionHeader}" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                    <Button x:Name="NewButton" DockPanel.Dock="Left" Content="New project…" Style="{StaticResource TextButton}" Padding="12,4" Click="NewButton_Click" />
                    <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove project from ForgeDesk" Click="RemoveButton_Click" />
                    <Button x:Name="ArchiveButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7B8;" ToolTip="Archive" Click="ArchiveButton_Click" />
                    <Button x:Name="DownButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74B;" ToolTip="Move down (right in the tab bar)" Click="DownButton_Click" />
                    <Button x:Name="UpButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Move up (left in the tab bar)" Click="UpButton_Click" />
                </DockPanel>
                <ListBox x:Name="ProjectList" Style="{StaticResource PlainListBox}" SelectionChanged="ProjectList_SelectionChanged" KeyDown="ProjectList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Grid Width="8" Height="8" Margin="0,1,10,0" VerticalAlignment="Center">
                                    <Ellipse Fill="{DynamicResource TextTertiaryBrush}" />
                                    <Ellipse Fill="{Binding Color, Converter={StaticResource ColorToBrush}}" />
                                </Grid>
                                <TextBlock x:Name="ArchivedTag" DockPanel.Dock="Right" Text="archived" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                    <Setter TargetName="ArchivedTag" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Details -->
        <Grid Grid.Column="1" Grid.Row="0" Margin="22,16,22,0" x:Name="DetailsPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" MaxLength="80" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"
                             LostKeyboardFocus="NameBox_LostKeyboardFocus" KeyDown="NameBox_KeyDown" />
                    <TextBlock Text="Colour" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                    <WrapPanel x:Name="SwatchPanel" />
                </StackPanel>
                <Button x:Name="OpenButton" Grid.Column="1" VerticalAlignment="Top" Margin="0,18,0,0" Content="Open on desk"
                        Style="{StaticResource TextButton}" Click="OpenButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:MappingListEditor x:Name="ChatGptEditor" Grid.Column="0" />
                <views:MappingListEditor x:Name="ClaudeEditor" Grid.Column="2" />
            </Grid>
        </Grid>
        <TextBlock x:Name="NoSelectionText" Grid.Column="1" Grid.Row="0" Style="{StaticResource HintText}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   Text="Create a project to start mapping conversations." />

        <!-- Footer -->
        <DockPanel Grid.Column="1" Grid.Row="1" Margin="22,14,22,16">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource AccentButton}" MinWidth="88" IsCancel="True" Click="CloseButton_Click" />
            <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Changes are saved automatically. Removing a project or conversation only affects ForgeDesk — nothing is deleted on ChatGPT or Claude." />
        </DockPanel>
    </Grid>
</Window>
