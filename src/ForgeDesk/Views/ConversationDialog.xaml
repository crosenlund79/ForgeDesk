<Window x:Class="ForgeDesk.Views.ConversationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add conversation" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="22,20,22,18">
        <TextBlock x:Name="HeadingText" Text="Add conversation" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Name="SubheadingText" Style="{StaticResource HintText}" Margin="0,0,0,14" />

        <TextBlock Text="Conversation link" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UrlBox" Style="{StaticResource FieldTextBox}" TextChanged="Input_TextChanged" />
        <StackPanel x:Name="StatusPanel" Orientation="Horizontal" Margin="0,6,0,0" MinHeight="18">
            <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,6,0" VerticalAlignment="Top" />
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>

        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource FieldTextBox}" MaxLength="80" TextChanged="Input_TextChanged" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                   Text="Only this ForgeDesk mapping is named here; the conversation itself is not changed." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource TextButton}" IsCancel="True" MinWidth="84" />
            <Button x:Name="OkButton" Content="Add" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="84"
                    Margin="8,0,0,0" Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
