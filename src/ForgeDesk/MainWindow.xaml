<Window x:Class="ForgeDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ForgeDesk.Views"
        Title="ForgeDesk" Width="1400" Height="860" MinWidth="720" MinHeight="460"
        Icon="pack://application:,,,/ForgeDesk;component/Assets/ForgeDesk.ico"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="DeskProjectTab" TargetType="ListBoxItem" BasedOn="{StaticResource ProjectTabItem}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProjectTab_PreviewMouseRightButtonDown" />
            <EventSetter Event="MouseRightButtonUp" Handler="ProjectTab_MouseRightButtonUp" />
            <EventSetter Event="MouseDoubleClick" Handler="ProjectTab_MouseDoubleClick" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="900" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Project tabs -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel Height="38" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
                    <Button x:Name="AllProjectsButton" Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="12"
                            ToolTip="All projects" Click="AllProjectsButton_Click" />
                    <Button x:Name="AppMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;"
                            ToolTip="Menu" Click="AppMenuButton_Click" />
                </StackPanel>
                <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroller_PreviewMouseWheel" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <ListBox x:Name="ProjectTabs" Style="{StaticResource TabStripListBox}"
                                 ItemContainerStyle="{StaticResource DeskProjectTab}"
                                 SelectionChanged="ProjectTabs_SelectionChanged" />
                        <Button x:Name="NewProjectButton" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="12"
                                Margin="2,0,0,0" VerticalAlignment="Center" ToolTip="New project" Click="NewProjectButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The desk: ChatGPT | splitter | Claude -->
        <Grid Grid.Row="1" x:Name="DeskGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="280" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <views:PaneView x:Name="LeftPane" Grid.Column="0" />
            <GridSplitter x:Name="Splitter" Grid.Column="1" Style="{StaticResource DeskSplitter}" ToolTipService.InitialShowDelay="1500"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False"
                          ToolTip="Drag to resize · double-click to split evenly"
                          DragCompleted="Splitter_DragCompleted" MouseDoubleClick="Splitter_MouseDoubleClick" />
            <views:PaneView x:Name="RightPane" Grid.Column="2" />
        </Grid>

        <!-- Welcome / prerequisites (the desk is collapsed while this shows) -->
        <Grid Grid.Row="1" x:Name="WelcomePanel" Visibility="Collapsed" Background="{DynamicResource WindowBackgroundBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="24">
                <Image Source="pack://application:,,,/ForgeDesk;component/Assets/ForgeDesk.png" Width="56" Height="56" Margin="0,0,0,16" />
                <TextBlock x:Name="WelcomeTitle" Text="ForgeDesk" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="WelcomeTagline" Text="One desk. Two assistants. Your projects." FontSize="14" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                <TextBlock x:Name="WelcomeBody" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <Button x:Name="WelcomePrimary" Style="{StaticResource AccentButton}" Click="WelcomePrimary_Click" />
                    <Button x:Name="WelcomeSecondary" Style="{StaticResource TextButton}" Margin="8,0,0,0" Click="WelcomeSecondary_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
