<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ForgeDesk light palette. Keys are shared with Dark.xaml. -->
    <Color x:Key="ContentBackgroundColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FFEDEDF0" />
    <SolidColorBrush x:Key="PaneHeaderBackgroundBrush" Color="#FFF9F9FA" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFE1E1E6" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFE6E6EA" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#FFC9C9D1" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1C1C20" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5D5D66" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF91919A" />

    <SolidColorBrush x:Key="HoverBrush" Color="#FFE4E4E9" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FFD9D9DF" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#FFE0E2F5" />
    <SolidColorBrush x:Key="SubtleButtonBrush" Color="#FFE7E7EC" />
    <SolidColorBrush x:Key="SubtleButtonHoverBrush" Color="#FFDCDCE2" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FFCDCDD4" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F5BD5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF4350C4" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFFFF6E3" />
    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#FF7A5512" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FFEEF0FC" />
    <SolidColorBrush x:Key="InfoForegroundBrush" Color="#FF3A44A8" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FFFDECEC" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFB42318" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#FF1A7F55" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FF8A5A00" />

    <SolidColorBrush x:Key="ChatGptBrush" Color="#FF10A37F" />
    <SolidColorBrush x:Key="ClaudeBrush" Color="#FFC96442" />
</ResourceDictionary>
