<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ForgeDesk dark palette. Keys are shared with Light.xaml. -->
    <Color x:Key="ContentBackgroundColor">#FF212121</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1B1B1D" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="PaneHeaderBackgroundBrush" Color="#FF1D1D20" />
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="{StaticResource ContentBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF242427" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF2D2D31" />
    <SolidColorBrush x:Key="SplitterBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="SplitterHoverBrush" Color="#FF3A3A40" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFEDEDEF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA3A3AB" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6C6C74" />

    <SolidColorBrush x:Key="HoverBrush" Color="#FF29292D" />
    <SolidColorBrush x:Key="PressedBrush" Color="#FF333338" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#FF2F2F35" />
    <SolidColorBrush x:Key="SubtleButtonBrush" Color="#FF2A2A2E" />
    <SolidColorBrush x:Key="SubtleButtonHoverBrush" Color="#FF35353A" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF1F1F22" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#FF3A3A40" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FF8391FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF97A3FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF101226" />

    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FF262219" />
    <SolidColorBrush x:Key="NoticeForegroundBrush" Color="#FFE9C98A" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FF1E2130" />
    <SolidColorBrush x:Key="InfoForegroundBrush" Color="#FFAEB7FF" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FF2E1D1F" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FFFF9A9A" />
    <SolidColorBrush x:Key="SuccessForegroundBrush" Color="#FF7DD3A8" />
    <SolidColorBrush x:Key="WarningForegroundBrush" Color="#FFE9C98A" />

    <SolidColorBrush x:Key="ChatGptBrush" Color="#FF10A37F" />
    <SolidColorBrush x:Key="ClaudeBrush" Color="#FFD97757" />
</ResourceDictionary>
